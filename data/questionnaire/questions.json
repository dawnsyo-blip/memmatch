        {"id": "audio", "label": "要，需要保留语音", "effect": {"score": [
          {"if": {"media_recall": ["audio"]}, "points": 3, "reason": "能存下原始语音，以后还能找回来"}]}},
        {"id": "video", "label": "要，需要保留视频", "effect": {"score": [
          {"if": {"media_recall": ["video"]}, "points": 3, "reason": "能存下原视频，以后还能找回来"}]}},
