         "effect": {"any_of": [
           {"when": {"question": "q2", "selected_any": ["anthropic"]}, "require": {"compatible_clients": ["claude_web_mobile"]}, "exclude_any": {"category": ["自带记忆的应用"]}},
           {"when": {"question": "q2", "selected_any": ["anthropic", "google"]}, "require": {"phone_access": ["remote_mcp"]}, "exclude_any": {"category": ["自带记忆的应用"]}},
           {"when": {"question": "q2", "selected_any": ["openai"]}, "require": {"id": ["method-notion"]}}
