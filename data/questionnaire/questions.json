        {"id": "know", "label": "还没用过，但对 LLM 记忆有些了解", "free_text": true, "exclusive": true, "help": "请填写您所知道的记忆项目"},
        {"id": "none", "label": "没用过，也不太了解", "exclusive": true}
      ],
      "rules": [
        {"when": {"question": "q6", "selected_any": ["notes"]},
         "score": [{"if": {"human_review": ["files"], "export": ["markdown"]}, "unless": {"project_role": ["method"]}, "points": 2,
                    "reason": "记忆存成 Markdown 文件，能放进您的笔记库直接看和改"}]}
      ]
    },
    {
      "id": "q8", "number": "8", "kind": "preference", "type": "rank", "short": "遇到过的记忆问题",
      "text": "在以下记忆问题中，您遇到过哪些？",
      "help": "请按排斥程度排序。",
      "show_if": {"question": "q6", "selected_none": ["know", "none"]},
      "options": [
        {"id": "entry_hallucination", "label": "录入幻觉", "help": "LLM 说“记住了”，其实没有记", "effect": {"score": [
          {"if": {"human_review": ["*"]}, "points": 0.5, "reason": "随时能看到记了什么"},
          {"if": {"write_mode": ["review_first"]}, "points": 2, "reason": "先给您看候选再入库"},
          {"if": {"write_receipt": ["yes"]}, "points": 2, "reason": "写入后会明确回执"}]}},
        {"id": "window_loss", "label": "换窗失忆", "help": "开启新窗口以后需要复述之前讲过的问题", "effect": {"score": [
          {"if": {"window_handoff": ["yes"]}, "points": 1, "reason": "开新窗口能接上之前的内容"},
          {"if": {"cross_client": ["yes"]}, "points": 1, "reason": "几个入口共用一份记忆"}]}},
        {"id": "overwrite", "label": "错误覆写", "help": "记了新信息，旧的就被整个覆盖了", "effect": {"score": [
          {"if": {"error_guard": ["yes"]}, "points": 1, "reason": "新事实取代旧事实时保留历史，能纠错"},
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "记得每件事是什么时候的"}]}},
        {"id": "no_priority", "label": "轻重不分", "help": "忘记不常提起但重要的事，或者在不合适的时候提起错误的事", "effect": {"score": [
          {"if": {"multi_factor": ["multi"]}, "points": 1, "reason": "综合重要性、新旧等多个维度决定先想起什么"},
          {"if": {"ranking_signals": ["importance"]}, "points": 1, "reason": "会给记忆打重要性分"},
          {"if": {"emotion_handling": ["weighting"]}, "points": 1, "reason": "情绪重的记忆记得更牢"},
          {"if": {"sensitive_suppression": ["yes"]}, "points": 1, "reason": "能压住您不想再提的事"}]}},
        {"id": "you_me", "label": "你我不分", "help": "LLM 回忆时把“你说的”和“我说的”弄混", "effect": {"score": [
          {"if": {"verbatim": ["yes"]}, "points": 1, "reason": "保留原话，能查是谁说的"},
          {"if": {"error_guard": ["yes"]}, "points": 1, "reason": "记忆能追溯来源"}]}},
        {"id": "stereotype", "label": "刻板印象", "help": "知道关于我的事，却不记得这件事对我意味着什么", "effect": {"score": [
          {"if": {"verbatim": ["yes"]}, "points": 1, "reason": "保留原话，不只剩摘要"},
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "有时间线，知道事情的来龙去脉"},
          {"if": {"ranking_signals": ["confidence"]}, "points": 1, "reason": "区分确定和不确定的认识"}]}},
        {"id": "verbatim_repeat", "label": "逐字复述", "help": "一字一句复述原句，让人有压力", "effect": {"score": [
          {"if": {"lifecycle": ["consolidate"]}, "points": 1, "reason": "会整理成摘要，原话只留档"}]}},
        {"id": "fabrication", "label": "凭空编造", "help": "LLM 自己“反思”之后，编出没发生过的事", "effect": {"score": [
          {"if": {"reflection": ["yes"], "error_guard": ["yes"]}, "points": 2, "reason": "反思得出的结论能追溯到原话"},
          {"if": {"reflection": ["yes"]}, "unless": {"error_guard": ["yes"]}, "points": -1, "reason": "会自己反思总结，但结论追溯不到原话"}]}},
        {"id": "messy", "label": "越记越乱", "help": "记忆重复堆积，回应越来越慢", "effect": {"score": [
          {"if": {"dream_consolidation": ["yes"]}, "points": 1, "reason": "空闲时会自动整理、去重"},
          {"if": {"lifecycle": ["consolidate"]}, "points": 1, "reason": "会合并重复的记忆"}]}},
        {"id": "other", "label": "其他", "free_text": true},
        {"id": "no_problem", "label": "没有遇到过明显的问题", "exclusive": true}
      ]
    },
