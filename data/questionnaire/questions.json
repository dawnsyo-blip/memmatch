        {"id": "review_first", "label": "我审查后再录入", "help": "记忆更精简、更准，但要在录入时或定期花时间审查", "effect": {"score": [
          {"if": {"write_mode": ["review_first"]}, "points": 4, "reason": "先给您审核，您同意了才记"},
