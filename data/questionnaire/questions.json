          {"if": {"customization": ["plain_data"]}, "points": 1, "reason": "记忆是普通文件，可以直接改"}]}},
        {"id": "often", "label": "我想经常整理：愿意定期投入一定时间修剪和钉选", "default_if": {"question": "q9", "selected_any": ["review_first"]}, "effect": {"score": [
          {"if": {"human_review": ["dashboard"]}, "points": 1, "reason": "有网页面板可以查看修改"},
          {"if": {"pinning": ["yes"]}, "points": 1, "reason": "能把重要的记忆钉住"},
          {"if": {"customization": ["plain_data"]}, "points": 1, "reason": "记忆是普通文件，可以直接改"}]}}
