{
  "version": "2026-10-11",
  "note": "硬条件部分由 Claude 起草，供负责人修改；偏好部分待负责人编写。格式说明见 docs/questionnaire-format.md。",
  "questions": [
    {
      "id": "client",
      "kind": "hard",
      "type": "multi",
      "combine": "any",
      "text": "你平时在哪里和 AI 聊天？",
      "help": "可以多选。记忆库要“接”到你用的聊天入口上，入口不同，能用的记忆库差别很大。",
      "options": [
        {
          "id": "claude_web_mobile",
          "label": "Claude 官方网页或手机 App",
          "help": "需要记忆库支持“远程连接”（在网页设置里添加自定义连接器），能用的选择较少。",
          "effect": {"require": {"compatible_clients": ["claude_web_mobile"]}}
        },
        {
          "id": "claude_desktop",
          "label": "Claude 桌面版（电脑上安装的 Claude）",
          "effect": {"require": {"compatible_clients": ["claude_desktop", "any_mcp_client"]}}
        },
        {
          "id": "claude_code",
          "label": "Claude Code（命令行里的 Claude）",
          "effect": {"require": {"compatible_clients": ["claude_code", "any_mcp_client"]}}
        },
        {
          "id": "chatgpt",
          "label": "ChatGPT",
          "effect": {"require": {"compatible_clients": ["chatgpt"]}}
        },
        {
          "id": "mcp_client",
          "label": "支持 MCP 的第三方聊天软件（如 Cherry Studio、Kelivo、ChatBox）",
          "help": "MCP（模型上下文协议）是让 AI 调用外部工具的通用接口。软件设置里有“MCP 服务器”一项的就算。",
          "effect": {"require": {"compatible_clients": ["any_mcp_client", "kelivo"]}}
        },
        {
          "id": "custom_endpoint",
          "label": "只能改“接口地址”的聊天软件（如 SillyTavern 酒馆）",
          "help": "这类软件不支持 MCP，只能用“网关”式记忆库：把软件里的接口地址改成记忆库的地址。",
          "effect": {"require": {"compatible_clients": ["openai_compatible", "sillytavern", "open_webui"]}}
        },
        {
          "id": "openclaw_hermes",
          "label": "OpenClaw 或 Hermes 这类个人 agent",
          "effect": {"require": {"compatible_clients": ["openclaw", "hermes"]}}
        },
        {
          "id": "im_bot",
          "label": "在 QQ、微信、Telegram、飞书等聊天软件里和 AI 机器人聊（如 AstrBot）",
          "effect": {"require": {"compatible_clients": ["astrbot", "telegram", "wechat", "feishu", "discord"]}}
        },
        {
          "id": "coding_tools",
          "label": "Cursor、Codex、Gemini CLI 等编程工具",
          "effect": {"require": {"compatible_clients": ["cursor", "codex", "gemini_cli", "opencode", "any_mcp_client"]}}
        },
        {
          "id": "new_app",
          "label": "还没有固定的助手，愿意直接用一个自带记忆的应用",
          "help": "这类应用自带聊天界面和记忆，记忆不能搬到别的助手上用。",
          "effect": {"require": {"category": ["自带记忆的应用"]}}
        }
      ]
    },
    {
      "id": "devices",
      "kind": "hard",
      "type": "multi",
      "combine": "any",
      "text": "你有哪些地方可以运行记忆库？",
      "help": "可以多选。大多数记忆库要在一台设备上一直运行，聊天时才能随时取用记忆。",
      "options": [
        {
          "id": "computer",
          "label": "一台经常开着的电脑",
          "effect": {"require": {"runs_on": ["own_computer"]}}
        },
        {
          "id": "server",
          "label": "自己的服务器、VPS 或 NAS",
          "effect": {"require": {"runs_on": ["own_server"]}}
        },
        {
          "id": "cloud_account",
          "label": "愿意注册免费云平台账号来部署（如 Cloudflare、Render）",
          "help": "部署在你自己的云账号里，全程用浏览器操作，不需要自己的电脑一直开着。",
          "effect": {"require": {"runs_on": ["own_cloud_account"]}}
        },
        {
          "id": "phone",
          "label": "只有手机",
          "effect": {"require": {"runs_on": ["phone", "own_cloud_account"]}}
        },
        {
          "id": "hosted",
          "label": "可以接受用项目方提供的托管服务",
          "help": "托管服务由项目方运行，你的对话内容会存到对方的服务器上。",
          "effect": {"require": {"runs_on": ["third_party_hosted"]}}
        }
      ]
    },
    {
      "id": "os",
      "kind": "hard",
      "type": "single",
      "show_if": {"question": "devices", "selected_any": ["computer"]},
      "text": "你的电脑是什么系统？",
      "help": "只影响需要装在你电脑上的记忆库；装在服务器或云上的不受影响。",
      "options": [
        {"id": "windows", "label": "Windows",
         "effect": {"require": {"os": ["windows", "any"]}, "when_only": {"runs_on": ["own_computer"]}}},
        {"id": "macos", "label": "macOS（苹果电脑）",
         "effect": {"require": {"os": ["macos", "any"]}, "when_only": {"runs_on": ["own_computer"]}}},
        {"id": "linux", "label": "Linux",
         "effect": {"require": {"os": ["linux", "any"]}, "when_only": {"runs_on": ["own_computer"]}}}
      ]
    },
    {
      "id": "accounts",
      "kind": "hard",
      "type": "multi",
      "combine": "allow",
      "constraint": {"field": "accounts_needed", "always_allowed": ["none"]},
      "text": "下面这些账号或付费服务，你愿意准备哪些？",
      "help": "可以多选，也可以都不选。需要你没勾选的账号的记忆库会被筛掉。",
      "options": [
        {"id": "model_api_key", "label": "大模型接口密钥（API Key，按用量付费，如 OpenAI、DeepSeek）",
         "help": "很多记忆库要调用大模型来整理记忆。用本地模型（如 Ollama）的不需要。",
         "effect": {"allow": {"accounts_needed": ["model_api_key"]}}},
        {"id": "github", "label": "GitHub 账号", "effect": {"allow": {"accounts_needed": ["github"]}}},
        {"id": "cloudflare", "label": "Cloudflare 账号", "effect": {"allow": {"accounts_needed": ["cloudflare"]}}},
        {"id": "render", "label": "Render 账号", "effect": {"allow": {"accounts_needed": ["render"]}}},
        {"id": "vendor_account", "label": "记忆库项目方自己的账号", "effect": {"allow": {"accounts_needed": ["vendor_account"]}}},
        {"id": "telegram", "label": "Telegram 机器人", "effect": {"allow": {"accounts_needed": ["telegram"]}}},
        {"id": "claude_subscription", "label": "Claude 付费套餐（Pro 或 Max）", "effect": {"allow": {"accounts_needed": ["claude_subscription"]}}}
      ]
    },
    {
      "id": "difficulty",
      "kind": "hard",
      "type": "single",
      "text": "安装和设置，你能接受到什么程度？",
      "help": "门槛是根据说明文档判断的，没有实际安装验证。",
      "options": [
        {"id": "low", "label": "只想下载安装包、点几下就能用",
         "effect": {"require": {"difficulty": ["low"]}, "exclude_only": {"category": ["需写代码（开发者向）"]}}},
        {"id": "medium", "label": "能照着教程敲几条命令、填一些设置",
         "effect": {"require": {"difficulty": ["low", "medium"]}, "exclude_only": {"category": ["需写代码（开发者向）"]}}},
        {"id": "high", "label": "会用 Docker、改配置文件，或者能写点代码",
         "effect": {}}
      ]
    },
    {
      "id": "cost",
      "kind": "hard",
      "type": "single",
      "text": "运行费用方面，你能接受哪种？",
      "options": [
        {"id": "free", "label": "必须完全免费", "effect": {"require": {"cost": ["free"]}}},
        {"id": "model_fees", "label": "可以付一点大模型调用费", "effect": {"require": {"cost": ["free", "model_fees_only"]}}},
        {"id": "paid", "label": "可以付订阅或云服务费用", "effect": {}}
      ]
    },
    {
      "id": "third_party",
      "kind": "hard",
      "type": "single",
      "text": "你能接受聊天内容存到别人的服务器上吗？",
      "help": "这里只看记忆库本身。如果你用的是云端大模型（Claude、ChatGPT 等），对话本来就会发给模型提供方。",
      "options": [
        {"id": "no", "label": "不能，记忆必须存在我自己的设备或账号里",
         "effect": {"exclude_only": {"data_passes_through": ["third_party"]}}},
        {"id": "yes", "label": "可以", "effect": {}}
      ]
    },
    {
      "id": "edge",
      "kind": "hard",
      "type": "single",
      "text": "要不要把“边缘项目”也列出来？",
      "help": "边缘项目存的不是对话记忆，而是 AI 的情绪状态或模型本身（如 Drivesoid、OmniDimen Emotion），可以和记忆库搭配使用。",
      "options": [
        {"id": "no", "label": "不用，只看记忆库", "effect": {"exclude_only": {"category": ["边缘项（存的不是对话记忆）"]}}},
        {"id": "yes", "label": "也列出来看看", "effect": {}}
      ]
    },
    {
      "id": "commercial",
      "kind": "hard",
      "type": "single",
      "text": "你会把记忆库用在商业用途上吗（比如做成产品或给公司用）？",
      "help": "个人使用一般不受许可证限制；商业用途需要避开禁止商用或限制使用的项目。",
      "options": [
        {"id": "no", "label": "不会，只是个人使用", "effect": {}},
        {"id": "yes", "label": "会", "effect": {"exclude_only": {"license_category": ["noncommercial", "source_available", "no_license"]}}}
      ]
    }
  ]
}
