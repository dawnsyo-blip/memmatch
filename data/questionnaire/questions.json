        {"id": "any", "label": "都可以", "exclusive": true, "effect": {"score": [
          {"if": {"media_recall": ["image", "audio", "video"]}, "points": 1, "reason": "能存下图片、语音或视频的原件"}]}}
      ]
    },
    {
      "id": "q10", "kind": "preference", "type": "single", "short": "写入把关",
      "text": "LLM 从对话里录入记忆时，您更希望怎么把关？",
      "options": [
        {"id": "auto", "label": "LLM 完全自动判断", "help": "省时省力，但可能有重复或记错的地方", "effect": {"score": [
          {"if": {"write_mode": ["auto"]}, "points": 2, "reason": "会自动记，不用您操心"},
          {"if": {"lifecycle": ["consolidate"]}, "points": 1, "reason": "会自动整理、合并记忆"}]}},
        {"id": "auto_review", "label": "LLM 自动录入，我事后审查", "help": "录入时不中断对话，需要时我能打开检查并修正", "effect": {"score": [
