{
  "version": "v4-2026-10-25",
  "note": "按负责人确认的《记忆库推荐问卷 v4》编写。网站和推荐引擎只读这个文件；格式说明见 docs/questionnaire-format.md。",
  "rank_weights": [3, 2, 1],
  "rank_rest": 1,
  "result": {"top_n": 8, "min_results": 3, "unknown_penalty": 1},
  "field_labels": {
    "compatible_clients": "能配合哪些入口", "runs_on": "运行位置", "os": "支持的系统", "difficulty": "上手门槛",
    "cost": "费用", "accounts_needed": "需要的账号", "phone_access": "手机能否连上", "setup_device": "只用手机能否装好", "data_passes_through": "数据经过谁的服务器",
    "model_api_key": "大模型接口密钥", "claude_subscription": "Claude 付费套餐", "github": "GitHub 账号",
    "vendor_account": "项目方账号", "cloudflare": "Cloudflare 账号", "render": "Render 账号", "telegram": "Telegram 机器人",
    "difficulty:low": "低（下载安装或一键安装）", "difficulty:medium": "中（照着教程敲几条命令）", "difficulty:high": "高（要改较多配置或写代码）",
    "settings_ui": "可以在界面里改设置", "config_file": "可以改配置文件", "prompts": "可以改提示词", "plain_data": "记忆是普通文件，可以直接改",
    "plugin_api": "留了插件接口", "small_code": "代码小巧，方便自己改"
  },
  "questions": [
    {
      "id": "q1", "kind": "hard", "type": "multi", "short": "大模型厂商",
      "text": "您目前主要使用哪个厂商提供的模型？",
      "options": [
        {"id": "anthropic", "label": "Anthropic（Claude）"},
        {"id": "openai", "label": "OpenAI（ChatGPT、GPT）"},
        {"id": "google", "label": "Google（Gemini）"},
        {"id": "glm", "label": "智谱（GLM）"},
        {"id": "deepseek", "label": "DeepSeek"},
        {"id": "kimi", "label": "月之暗面（Kimi）"},
        {"id": "qwen", "label": "阿里（通义千问）"},
        {"id": "doubao", "label": "字节（豆包）"},
        {"id": "local", "label": "开源模型，本地运行"},
        {"id": "other", "label": "其它", "free_text": true}
      ],
      "rules": [
        {"when": {"question": "q1", "selected_none": ["anthropic"]}, "exclude_any": {"model_lock": ["claude_only"]},
         "reason": "只能配合 Claude 使用"},
        {"when": {"question": "q1", "selected_only_within": ["local"]},
         "score": [{"if": {"local_model": ["yes", "no_model_needed"]}, "points": 2, "reason": "可以只用本地模型"}]}
      ]
    },
    {
      "id": "q2", "kind": "hard", "type": "multi", "short": "设备",
      "text": "您目前手上有哪些设备？",
      "constraint": {"type": "os_match", "applies_runs_on_only": ["own_computer"]},
      "exclude_reason": "不支持您设备的系统",
      "options": [
        {"id": "iphone", "label": "iPhone 或 iPad", "values": {"os": ["ios"]}},
        {"id": "android", "label": "安卓手机或平板", "values": {"os": ["android"]}},
        {"id": "windows", "label": "Windows 电脑", "values": {"os": ["windows"]}},
        {"id": "mac", "label": "Mac 电脑", "values": {"os": ["macos"]}},
        {"id": "linux", "label": "Linux 电脑", "values": {"os": ["linux"]}},
        {"id": "server", "label": "自己的服务器、VPS 或 NAS", "values": {"os": ["linux"]}},
        {"id": "other", "label": "其它", "free_text": true}
      ],
      "rules": [
        {"when": {"question": "q2", "selected_none": ["windows", "mac", "linux", "server"]},
         "exclude_any": {"setup_device": ["needs_computer"]}, "reason": "安装或部署时要用电脑"}
      ]
    },
    {
      "id": "q3", "kind": "hard", "type": "multi", "short": "手机上的入口",
      "text": "您在手机上通过什么入口和 Agent 沟通？",
      "exclude_reason": "接不上您用的入口",
      "options": [
        {"id": "official", "label": "官方网页或手机 App，直接在 App 里聊", "help": "如 Claude、ChatGPT、Gemini、DeepSeek 的官方 App",
         "notice": "您选的官方 App 目前接不了自己部署的记忆库：ChatGPT 的自定义 MCP 只能在网页端用，DeepSeek、智谱、Kimi、通义千问、豆包的官方 App 不支持接外部记忆。可以考虑用手机遥控电脑上的 Agent、改用 Kelivo 这类客户端，或换用自带记忆的应用。",
         "effect": {"any_of": [
           {"when": {"question": "q1", "selected_any": ["anthropic"]}, "require": {"compatible_clients": ["claude_web_mobile"]}, "exclude_any": {"category": ["自带记忆的应用"]}},
           {"when": {"question": "q1", "selected_any": ["anthropic", "google"]}, "require": {"phone_access": ["remote_mcp"]}, "exclude_any": {"category": ["自带记忆的应用"]}}
         ]}},
        {"id": "remote_control", "label": "用手机远程操控电脑上的 Agent",
         "help": "如 Claude App 的 Remote Control 连电脑上的 Claude Code；ChatGPT App 的 Remote 连 Codex；DeepSeek Harness 的远程插件",
         "effect": {"require_selected": {"question": "q3a", "field": "compatible_clients", "extra": ["any_mcp_client"],
                                         "fallback": ["claude_code", "codex", "deepseek_harness"]},
                    "require": {"runs_on": ["own_computer"]}, "exclude_any": {"category": ["自带记忆的应用"]}}},
        {"id": "programmatic", "label": "通过 -p、codex exec 等程序化用法或第三方服务，接入自建前端或聊天平台",
         "help": "如用 Claude Code 搭的手机网页；用 AstrBot、Hermes 把 Agent 接进微信、QQ、Telegram",
         "effect": {"require_selected": {"question": "q3a", "field": "compatible_clients", "extra": ["any_mcp_client", "openai_compatible"]},
                    "exclude_any": {"category": ["自带记忆的应用"]}}},
        {"id": "mcp_client", "label": "Kelivo、RikkaHub、Operit 等支持 MCP 的客户端", "help": "自己填 API Key 的手机聊天软件",
         "effect": {"require": {"compatible_clients": ["kelivo", "any_mcp_client", "openai_compatible"]}, "exclude_any": {"category": ["自带记忆的应用"]}}},
        {"id": "sillytavern", "label": "SillyTavern（酒馆）", "help": "手机上一般用浏览器访问，本体跑在电脑或服务器上",
         "effect": {"require": {"compatible_clients": ["sillytavern", "openai_compatible"]}, "exclude_any": {"category": ["自带记忆的应用"]}}},
        {"id": "app", "label": "还没有固定使用的 Agent，计划换用一个自带记忆的应用", "help": "这类应用自带聊天界面和记忆，记忆不能搬到别的助手上用",
         "effect": {"require": {"category": ["自带记忆的应用"]}}},
        {"id": "other", "label": "其它", "free_text": true, "effect": {}}
      ],
      "rules": [
        {"when": {"question": "q3", "selected_only_within": ["official", "mcp_client", "other"]},
         "unless_project": {"category": ["自带记忆的应用"]},
         "any_of": [
           {"require": {"phone_access": ["native", "remote_mcp", "http_endpoint", "needs_tunnel"]}},
           {"when": {"question": "q5", "selected_any": ["hosted"]}, "require": {"phone_access": ["cloud"]}},
           {"when": {"question": "q5", "selected_any": ["cloud_free"]}, "require": {"runs_on": ["own_cloud_account"]}}
         ],
         "reason": "手机连不上这个记忆库", "note": "要自己用 Cloudflare Tunnel 或 Tailscale 让手机连上", "note_if": {"phone_access": ["needs_tunnel"]}}
      ],
      "relax": [
        {"label": "改用手机遥控电脑上的 Agent", "add": ["remote_control"]},
        {"label": "改用 Kelivo 这类支持 MCP 的客户端", "add": ["mcp_client"]},
        {"label": "考虑自带记忆的应用", "add": ["app"]}
      ]
    },
    {
      "id": "q3a", "kind": "info", "type": "multi", "short": "用的 Agent",
      "text": "您用的是哪个 Agent？",
      "show_if": {"question": "q3", "selected_any": ["remote_control", "programmatic"]},
      "options": [
        {"id": "claude_code", "label": "Claude Code", "values": {"compatible_clients": ["claude_code"]}},
        {"id": "codex", "label": "Codex", "values": {"compatible_clients": ["codex"]}},
        {"id": "gemini_cli", "label": "Gemini CLI", "values": {"compatible_clients": ["gemini_cli"]}},
        {"id": "deepseek_harness", "label": "DeepSeek Harness", "values": {"compatible_clients": ["deepseek_harness"]}},
        {"id": "openclaw", "label": "OpenClaw", "values": {"compatible_clients": ["openclaw"]}},
        {"id": "hermes", "label": "Hermes", "values": {"compatible_clients": ["hermes"]}},
        {"id": "bot_framework", "label": "AstrBot 等聊天机器人框架", "values": {"compatible_clients": ["astrbot", "telegram", "wechat", "feishu", "discord"]}},
        {"id": "other", "label": "其它", "free_text": true, "values": {"compatible_clients": ["any_mcp_client", "openai_compatible"]}}
      ],
      "rules": [
        {"when": {"question": "q3a", "selected_any": ["claude_code"]}, "score": [{"if": {"access": ["host_plugin"], "compatible_clients": ["claude_code"]}, "points": 2, "reason": "是能直接装进 Claude Code 的插件"}]},
        {"when": {"question": "q3a", "selected_any": ["codex"]}, "score": [{"if": {"access": ["host_plugin"], "compatible_clients": ["codex"]}, "points": 2, "reason": "是能直接装进 Codex 的插件"}]},
        {"when": {"question": "q3a", "selected_any": ["openclaw"]}, "score": [{"if": {"access": ["host_plugin"], "compatible_clients": ["openclaw"]}, "points": 2, "reason": "是 OpenClaw 的插件"}]},
        {"when": {"question": "q3a", "selected_any": ["hermes"]}, "score": [{"if": {"access": ["host_plugin"], "compatible_clients": ["hermes"]}, "points": 2, "reason": "是 Hermes 的插件"}]},
        {"when": {"question": "q3a", "selected_any": ["deepseek_harness"]}, "score": [{"if": {"compatible_clients": ["deepseek_harness"]}, "points": 2, "reason": "有 DeepSeek Harness 插件或指南"}]},
        {"when": {"question": "q3a", "selected_any": ["bot_framework"]}, "score": [{"if": {"access": ["host_plugin"], "compatible_clients": ["astrbot"]}, "points": 5, "reason": "是 AstrBot 插件，装上就能用"}]}
      ]
    },
    {
      "id": "q4", "kind": "hard", "type": "single", "short": "多端共用",
      "text": "您需要在几个地方共用同一份记忆？",
      "exclude_reason": "只能在一个地方用，没法多端共用",
      "options": [
        {"id": "single", "label": "只在手机上的一个入口用", "effect": {}},
        {"id": "multi", "label": "需要在几个设备或入口之间切换",
         "effect": {"exclude_any": {"pairing": ["self_contained"], "single_entry": ["yes"]}}}
      ],
      "rules": [
        {"when": {"question": "q4", "selected_any": ["multi"]},
         "note": "文档没写能否多端共用（MCP 服务一般可以同时给几个入口用）", "note_if": {"cross_client": ["not_mentioned"]},
         "score": [{"if": {"cross_client": ["yes"]}, "points": 2, "reason": "写明了能在几个入口共用同一份记忆"}]}
      ]
    },
    {
      "id": "q5", "kind": "hard", "type": "multi", "short": "记忆库放在哪",
      "text": "可以接受记忆库放在哪里运行？",
      "help": "大多数记忆库要在一台设备上一直运行，聊天时才能随时取用记忆。",
      "combine": "union", "union_field": "runs_on", "unless_project": {"category": ["自带记忆的应用"]},
      "exclude_reason": "运行位置不符合您的选择",
      "options": [
        {"id": "computer", "label": "一台经常开着的电脑", "help": "0 元（电费另计）", "values": {"runs_on": ["own_computer"]},
         "default_if": {"question": "q3", "selected_any": ["remote_control"]}},
        {"id": "server", "label": "已经有的服务器、VPS 或 NAS", "help": "0 元", "values": {"runs_on": ["own_server"]}},
        {"id": "vps_new", "label": "可以新买一台便宜的 VPS", "help": "约 20–50 元/月（1 核、1–2G 内存够用）", "values": {"runs_on": ["own_server"]}},
        {"id": "cloud_free", "label": "注册免费云平台账号（Cloudflare、Render 等），全程用浏览器操作", "help": "免费额度内 0 元；Render 免费档闲置会休眠", "values": {"runs_on": ["own_cloud_account"]}},
        {"id": "phone", "label": "只用手机", "help": "0 元", "values": {"runs_on": ["phone"]}},
        {"id": "hosted", "label": "可以接受项目方提供的托管服务（对话内容会存到对方服务器）", "help": "有免费档，订阅一般每月几十元到上百元", "values": {"runs_on": ["third_party_hosted"]}}
      ],
      "rules": [
        {"when": {"question": "q5", "selected_none": ["hosted"]}, "exclude_only": {"data_passes_through": ["third_party"]},
         "reason": "只能用项目方的托管服务"},
        {"when": {"question": "q5", "selected_none": ["hosted"]},
         "note": "按自己部署的方式用（默认是托管）", "note_if": {"runs_on": ["third_party_hosted"]}}
      ],
      "relax": [
        {"label": "可以用一台经常开着的电脑", "add": ["computer"]},
        {"label": "注册免费云平台账号", "add": ["cloud_free"]},
        {"label": "新买一台便宜的 VPS", "add": ["vps_new"]},
        {"label": "接受项目方的托管服务", "add": ["hosted"]}
      ]
    },
    {
      "id": "q6", "kind": "info", "type": "single", "short": "熟悉程度",
      "text": "您目前主要在使用什么记忆服务？",
      "options": [
        {"id": "native", "label": "客户端自带的记忆服务（比如 ChatGPT、Claude 的记忆功能，或 Operit 自带的记忆）"},
        {"id": "open_source", "label": "开源的记忆项目（比如各类 MCP）"},
        {"id": "other", "label": "用过其它类型的记忆项目", "free_text": true, "help": "请填写您所用过的记忆项目"},
        {"id": "know", "label": "还没用过，但对 Agent 记忆有些了解", "free_text": true, "help": "请填写您所知道的记忆项目"},
        {"id": "none", "label": "没用过，也不太了解"}
      ]
    },
    {
      "id": "q7", "kind": "preference", "type": "rank", "short": "常做的事",
      "text": "您常和 Agent 共同进行什么活动？",
      "help": "可多选，按顺序点选，越靠前越重要",
      "options": [
        {"id": "companion", "label": "聊天与陪伴", "effect": {"score": [
          {"if": {"persona_continuity": ["yes"]}, "points": 1, "reason": "换窗、换模型后还是同一个 TA"},
          {"if": {"emotion_handling": ["tags", "weighting", "ai_state", "user_mood"]}, "points": 1, "reason": "会记住和处理情绪"},
          {"if": {"proactive": ["yes"]}, "points": 1, "reason": "会主动找您"},
          {"if": {"relationship_stage": ["yes"]}, "points": 1, "reason": "记录关系的进展"}]}},
        {"id": "roleplay", "label": "角色扮演或创作", "effect": {"score": [
          {"if": {"compatible_clients": ["sillytavern"]}, "points": 2, "reason": "是酒馆的记忆扩展"},
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "有时间线"},
          {"if": {"persona_continuity": ["yes"]}, "points": 1, "reason": "角色设定前后一致"}]}},
        {"id": "schedule", "label": "日程规划与管理", "effect": {"score": [
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "记得时间和日期"},
          {"if": {"proactive": ["yes"]}, "points": 1, "reason": "会主动提醒"}]}},
        {"id": "work", "label": "工作断线续做", "effect": {"score": [
          {"if": {"window_handoff": ["yes"]}, "points": 1, "reason": "开新窗口能接上之前的进度"},
          {"if": {"project_role": ["context_tool"]}, "points": 1, "reason": "专门管长对话不断线"},
          {"if": {"cross_client": ["yes"]}, "points": 1, "reason": "几个工具共用一份记忆"}]}},
        {"id": "coding", "label": "轻量编程", "effect": {"score": [
          {"if": {"memory_subject": ["task_context", "experience"]}, "points": 1, "reason": "能记任务进度和做事经验"}]}},
        {"id": "other", "label": "其他", "free_text": true}
      ]
    },
    {
      "id": "q8", "kind": "preference", "type": "rank", "short": "最排斥的问题",
      "text": "以下是在与 Agent 交流过程中可能会出现的记忆问题。您最排斥哪些问题？",
      "help": "可多选，按顺序点选，越靠前越重要",
      "options": [
        {"id": "entry_hallucination", "label": "录入幻觉：Agent 说“记住了”，其实没有记", "effect": {"score": [
          {"if": {"human_review": ["*"]}, "points": 1, "reason": "随时能看到记了什么"},
          {"if": {"write_mode": ["review_first"]}, "points": 1, "reason": "先给您看候选再入库"},
          {"if": {"write_receipt": ["yes"]}, "points": 1, "reason": "写入后会明确回执"}]}},
        {"id": "overwrite", "label": "错误覆写：记了新信息，旧的就被整个覆盖了", "effect": {"score": [
          {"if": {"error_guard": ["yes"]}, "points": 1, "reason": "新事实取代旧事实时保留历史，能纠错"},
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "记得每件事是什么时候的"}]}},
        {"id": "no_priority", "label": "轻重不分：忘记提及频率低但对我很重要的事，或者在不合适的时候提起让人难过的事", "effect": {"score": [
          {"if": {"multi_factor": ["multi"]}, "points": 1, "reason": "综合重要性、新旧等多个维度决定先想起什么"},
          {"if": {"ranking_signals": ["importance"]}, "points": 1, "reason": "会给记忆打重要性分"},
          {"if": {"emotion_handling": ["weighting"]}, "points": 1, "reason": "情绪重的记忆记得更牢"},
          {"if": {"sensitive_suppression": ["yes"]}, "points": 1, "reason": "能压住您不想再提的事"}]}},
        {"id": "you_me", "label": "你我不分：Agent 回忆时把“你说的”和“我说的”弄混", "effect": {"score": [
          {"if": {"verbatim": ["yes"]}, "points": 1, "reason": "保留原话，能查是谁说的"},
          {"if": {"error_guard": ["yes"]}, "points": 1, "reason": "记忆能追溯来源"}]}},
        {"id": "stereotype", "label": "刻板印象：知道关于我的事，却不记得这件事对我意味着什么", "effect": {"score": [
          {"if": {"verbatim": ["yes"]}, "points": 1, "reason": "保留原话，不只剩摘要"},
          {"if": {"time_awareness": ["yes"]}, "points": 1, "reason": "有时间线，知道事情的来龙去脉"},
          {"if": {"ranking_signals": ["confidence"]}, "points": 1, "reason": "区分确定和不确定的认识"}]}},
        {"id": "verbatim_repeat", "label": "逐字复述：一字一句复述原句，让人有压力", "effect": {"score": [
          {"if": {"lifecycle": ["consolidate"]}, "points": 1, "reason": "会整理成摘要，原话只留档"}]}},
        {"id": "fabrication", "label": "凭空编造：Agent 自己“反思”之后，编出没发生过的事", "effect": {"score": [
          {"if": {"reflection": ["yes"], "error_guard": ["yes"]}, "points": 2, "reason": "反思得出的结论能追溯到原话"}]}},
        {"id": "other", "label": "其他", "free_text": true}
      ]
    },
    {
      "id": "q9", "kind": "preference", "type": "single", "short": "写入把关",
      "text": "Agent 从聊天里记东西时，您希望怎么把关？",
      "options": [
        {"id": "auto", "label": "全自动：Agent 自己判断记什么。省心，但不一定记得准，错误记忆也容易堆积", "effect": {"score": [
