{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "记忆项目",
  "description": "每个项目一个文件，放在 data/projects/<id>.json。阶段 0（import_projects.py）写入导入字段并保留原文；阶段 1（normalize.py）把 info 里的自由文字整理成固定选项，写入 normalized。各字段的可选值以 normalize.py 里的 ENUMS 为准。",
  "type": "object",
  "required": [
    "id",
    "name",
    "repo_url",
    "source",
    "review_status",
    "candidate",
    "origins",
    "info",
    "repo_health",
    "raw"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "文件名，同时用作网址路径"
    },
    "name": {
      "type": "string"
    },
    "repo_url": {
      "type": "string",
      "description": "代码仓库链接；代码不在代码托管网站上的，填实际存放位置"
    },
    "source": {
      "enum": [
        "initial",
        "community"
      ],
      "description": "initial＝最初导入，community＝访客推荐"
    },
    "review_status": {
      "enum": [
        "reviewed",
        "unreviewed"
      ],
      "description": "是否经过负责人审核；只有 reviewed 的项目进入推荐结果"
    },
    "candidate": {
      "type": "object",
      "description": "候选表阶段的筛选结论",
      "required": [
        "category",
        "group_code",
        "decided_on"
      ],
      "properties": {
        "category": {
          "enum": [
            "可接入已有助手",
            "自带记忆的应用",
            "需写代码（开发者向）",
            "教程与搭建指南",
            "边缘项（存的不是对话记忆）",
            "做法（笔记软件当记忆）",
            "笔记软件连接器"
          ]
        },
        "group_code": {
          "type": "string",
          "description": "筛选时的分组代码（含义见 group_meaning）；空字符串表示直接符合标准"
        },
        "group_meaning": {
          "type": "string"
        },
        "decided_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "这个项目出现在哪些来源里"
    },
    "info": {
      "type": "object",
      "description": "使用信息（自由文字，未规范化）。每个字段都带来源和读取日期",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/sourced"
        },
        "memory_subject": {
          "$ref": "#/$defs/sourced"
        },
        "access": {
          "$ref": "#/$defs/sourced"
        },
        "compatible_clients": {
          "$ref": "#/$defs/sourced"
        },
        "runs_on": {
          "$ref": "#/$defs/sourced"
        },
        "difficulty": {
          "$ref": "#/$defs/sourced"
        },
        "accounts_needed": {
          "$ref": "#/$defs/sourced"
        },
        "license": {
          "$ref": "#/$defs/sourced"
        },
        "notes": {
          "$ref": "#/$defs/sourced"
        }
      },
      "additionalProperties": false
    },
    "repo_health": {
      "type": "object",
      "description": "仓库状态快照；阶段 2 会用 GitHub 接口补全",
      "properties": {
        "last_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "type": [
            "integer",
            "null"
          ]
        },
        "archived": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "read_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "raw": {
      "type": "object",
      "description": "各来源的原始字段原文，按来源名分组，供以后核对；不要修改"
    },
    "normalized": {
      "type": "object",
      "description": "阶段 1 规范化结果（含用户在意的 19 个特性，定义见 scripts/feature_rules.py；打分、情绪、定位、搭配、中文支持等 19 个字段见 scripts/dimension_rules.py）。status：confirmed 负责人确认／verified Claude 逐项对照 README 核实（data/readme_verification.json）／auto 规则判定／needs_review 待审核／unknown 文档未说明（值为空，原因见 uncertainties）",
      "required": [
        "access",
        "compatible_clients",
        "runs_on",
        "os",
        "difficulty",
        "cost",
        "accounts_needed",
        "memory_subject",
        "write_mode",
        "forgetting",
        "human_review",
        "export",
        "data_passes_through",
        "license_category",
        "persona_continuity",
        "window_handoff",
        "cross_client",
        "verbatim",
        "multimodal",
        "time_awareness",
        "dream_consolidation",
        "emotion",
        "proactive",
        "pinning",
        "error_guard",
        "import_history",
        "retrieval_weighting",
        "reflection",
        "relationship_stage",
        "independent_life",
        "visual_presence",
        "voice_interaction",
        "privacy_protection",
        "ranking_signals",
        "scoring_stages",
        "multi_factor",
        "emotion_handling",
        "project_role",
        "lifecycle",
        "lifecycle_complete",
        "pairing",
        "customization",
        "chinese_support",
        "memory_layers",
        "retrieval_postprocess",
        "recall_uses_llm",
        "sensitive_suppression",
        "write_receipt",
        "memory_writer",
        "phone_access",
        "local_model",
        "model_lock",
        "setup_device",
        "media_recall",
        "multi_agent",
        "spend",
        "spend_note",
        "usage_form",
        "token_inject",
        "token_background"
      ],
      "properties": {
        "access": {
          "$ref": "#/$defs/normalizedField"
        },
        "compatible_clients": {
          "$ref": "#/$defs/normalizedField"
        },
        "runs_on": {
          "$ref": "#/$defs/normalizedField"
        },
        "os": {
          "$ref": "#/$defs/normalizedField"
        },
        "difficulty": {
          "$ref": "#/$defs/normalizedField"
        },
        "cost": {
          "$ref": "#/$defs/normalizedField"
        },
        "accounts_needed": {
          "$ref": "#/$defs/normalizedField"
        },
        "memory_subject": {
          "$ref": "#/$defs/normalizedField"
        },
        "write_mode": {
          "$ref": "#/$defs/normalizedField"
        },
        "forgetting": {
          "$ref": "#/$defs/normalizedField"
        },
        "human_review": {
          "$ref": "#/$defs/normalizedField"
        },
        "export": {
          "$ref": "#/$defs/normalizedField"
        },
        "data_passes_through": {
          "$ref": "#/$defs/normalizedField"
        },
        "license_category": {
          "$ref": "#/$defs/normalizedField"
        },
        "persona_continuity": {
          "$ref": "#/$defs/normalizedField"
        },
        "window_handoff": {
          "$ref": "#/$defs/normalizedField"
        },
        "cross_client": {
          "$ref": "#/$defs/normalizedField"
        },
        "verbatim": {
          "$ref": "#/$defs/normalizedField"
        },
        "multimodal": {
          "$ref": "#/$defs/normalizedField"
        },
        "time_awareness": {
          "$ref": "#/$defs/normalizedField"
        },
        "dream_consolidation": {
          "$ref": "#/$defs/normalizedField"
        },
        "emotion": {
          "$ref": "#/$defs/normalizedField"
        },
        "proactive": {
          "$ref": "#/$defs/normalizedField"
        },
        "pinning": {
          "$ref": "#/$defs/normalizedField"
        },
        "error_guard": {
          "$ref": "#/$defs/normalizedField"
        },
        "import_history": {
          "$ref": "#/$defs/normalizedField"
        },
        "retrieval_weighting": {
          "$ref": "#/$defs/normalizedField"
        },
        "reflection": {
          "$ref": "#/$defs/normalizedField"
        },
        "relationship_stage": {
          "$ref": "#/$defs/normalizedField"
        },
        "independent_life": {
          "$ref": "#/$defs/normalizedField"
        },
        "visual_presence": {
          "$ref": "#/$defs/normalizedField"
        },
        "voice_interaction": {
          "$ref": "#/$defs/normalizedField"
        },
        "privacy_protection": {
          "$ref": "#/$defs/normalizedField"
        },
        "ranking_signals": {
          "$ref": "#/$defs/normalizedField"
        },
        "scoring_stages": {
          "$ref": "#/$defs/normalizedField"
        },
        "multi_factor": {
          "$ref": "#/$defs/normalizedField"
        },
        "emotion_handling": {
          "$ref": "#/$defs/normalizedField"
        },
        "project_role": {
          "$ref": "#/$defs/normalizedField"
        },
        "lifecycle": {
          "$ref": "#/$defs/normalizedField"
        },
        "lifecycle_complete": {
          "$ref": "#/$defs/normalizedField"
        },
        "pairing": {
          "$ref": "#/$defs/normalizedField"
        },
        "customization": {
          "$ref": "#/$defs/normalizedField"
        },
        "chinese_support": {
          "$ref": "#/$defs/normalizedField"
        },
        "memory_layers": {
          "$ref": "#/$defs/normalizedField"
        },
        "retrieval_postprocess": {
          "$ref": "#/$defs/normalizedField"
        },
        "recall_uses_llm": {
          "$ref": "#/$defs/normalizedField"
        },
        "sensitive_suppression": {
          "$ref": "#/$defs/normalizedField"
        },
        "write_receipt": {
          "$ref": "#/$defs/normalizedField"
        },
        "memory_writer": {
          "$ref": "#/$defs/normalizedField"
        },
        "phone_access": {
          "$ref": "#/$defs/normalizedField"
        },
        "local_model": {
          "$ref": "#/$defs/normalizedField"
        },
        "model_lock": {
          "$ref": "#/$defs/normalizedField"
        },
        "setup_device": {
          "$ref": "#/$defs/normalizedField"
        },
        "media_recall": {
          "$ref": "#/$defs/normalizedField"
        },
        "multi_agent": {
          "$ref": "#/$defs/normalizedField"
        },
        "spend": {
          "$ref": "#/$defs/normalizedField",
          "description": "要额外花多少钱（可多选）；金额等细节在 spend_note，逐项核实记在 data/spend_review.json"
        },
        "spend_note": {
          "$ref": "#/$defs/normalizedField",
          "description": "给用户看的一句话：需要一些额外花销来搭配这个项目，含 README 写明的金额"
        },
        "usage_form": {
          "$ref": "#/$defs/normalizedField",
          "description": "使用方式（可多选，第一个是主要方式）：plugin_chat 聊天软件插件、plugin_agent Agent 插件、service 独立服务、proxy 转发服务、chat_app 自带聊天界面的应用、app 独立应用、bot 聊天机器人、cli 命令行工具、library 开发者代码包、guide 教程或文档、method 做法、model 模型。只给结果页显示和搭配方案用，推荐规则不读；核对值在 data/usage_form.json"
        },
        "token_inject": {
          "$ref": "#/$defs/normalizedField",
          "description": "每轮带进对话的记忆量会不会随存的记忆变多：bounded 不会（按需检索只取若干条，或有固定上限）、capped 可设上限（默认会变多，但能限制）、grows 会、not_mentioned 未提及。核对值在 data/token_usage.json"
        },
        "token_background": {
          "$ref": "#/$defs/normalizedField",
          "description": "后台另外调用大模型的频率：none 不另外调用（由聊天模型或用户写入）、scheduled 定时、per_message 每轮或每次写入、not_mentioned 未提及。核对值在 data/token_usage.json"
        },
        "pairs_with": {
          "$ref": "#/$defs/normalizedField",
          "description": "设计上搭配使用的项目 id 列表（推荐引擎做组合推荐用），关系写在 scripts/dimension_rules.py 的 RELATED"
        },
        "paper_taxonomy": {
          "type": "object",
          "description": "论文分类（形态、功能、形成、演化、检索），沿用原表，仅用于详情页",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "uncertainties": {
      "type": "array",
      "description": "备注：哪些字段文档没说清、为什么。网站详情页据此显示“文档未说明”",
      "items": {
        "type": "object",
        "required": [
          "field",
          "label",
          "note"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "safety_note": {
      "type": "object",
      "description": "安全审查备注（data/safety_notes.json，normalize.py 写入）：推荐时应提醒用户注意的情况，不代表恶意。level：notice 需留意／info 知悉即可",
      "required": [
        "level",
        "note",
        "checked"
      ],
      "properties": {
        "level": {
          "enum": [
            "notice",
            "info"
          ]
        },
        "note": {
          "type": "string"
        },
        "checked": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourced": {
      "type": "object",
      "required": [
        "value",
        "source",
        "read_date"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "read_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "normalizedField": {
      "type": "object",
      "required": [
        "value",
        "status",
        "basis"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "confirmed",
            "verified",
            "auto",
            "needs_review",
            "unknown"
          ]
        },
        "basis": {
          "type": "string",
          "description": "判断依据：原文摘录或规则说明"
        }
      },
      "additionalProperties": false
    }
  }
}
